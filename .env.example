# ローカル開発用の設定例。コピーして .env を作り、値を入れる（.env はコミットしない）。
# Azure では同じ名前を App Service の「アプリ設定」に登録する。

# --- DB ---
# ローカル：SQL Server Express（Windows認証）
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=tanaoroshi_dev
# Windows認証の場合は true（DB_USER / DB_PASSWORD は不要）
DB_TRUSTED=true
# SQL認証の場合（Azure SQL）
DB_USER=
DB_PASSWORD=

# --- アプリ ---
# Cookieの Secure 属性。本番（HTTPS）は true（未設定でも true）。ローカルのhttpでは false
COOKIE_SECURE=false
# ログイン状態の有効日数（既定 30）
SESSION_DAYS=30
# セッション署名用の長いランダム文字列（本番とは別の値にする）
SECRET_KEY=
# 座標の暗号化の鍵（43文字）。作り方：python -c "from app.crypto import generate_key; print(generate_key())"
# 本番とは別の鍵にする。鍵を失うと、保存した座標は読めなくなる
COORD_ENCRYPTION_KEY=
# Azure本番の鍵の控え（任意。.env にだけ書く。コミットしない）。アプリは、この名前を使わない
# AZURE_COORD_ENCRYPTION_KEY=
